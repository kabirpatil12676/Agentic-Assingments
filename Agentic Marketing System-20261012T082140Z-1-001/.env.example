# ── LLM Provider ──────────────────────────────────────────────
# "ollama" (default, local) or "openai"
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ── Application ──────────────────────────────────────────────
# Set to "true" to run entirely offline with deterministic demo data
DEMO_MODE=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
# DB_PATH=data/marketing.db   # defaults to project-relative

# ── Workflow ─────────────────────────────────────────────────
MAX_OPT_LOOPS=3
OPT_THRESHOLD=0.05
